SYSTEM = MOF

# Electronic Relaxation
ISTART = 0
ICHARG = 2
ISMEAR = 0  # Gaussian smearing
SIGMA = 0.1
ENCUT = 1000.0  # Typically, VASP recommends using higher ENCUT, set to 2 * Ecutwfc in QE
PREC = Accurate

# Spin polarization

# vdW-DF functional
GGA       = ML
AGGAC     = 0.0
LUSE_VDW  = .TRUE.
ZAB_VDW   = -1.8867 # the default is -0.8491
LASPH     = .TRUE.
LUSE_VDW  = .TRUE.

# Convergence criteria
EDIFF = 1E-7
NELM = 500

# Ion relaxation (turn off ionic optimization)
IBRION = -1  # No ionic relaxation
NSW = 0  # Number of ionic steps to perform (0 means no ionic steps)

# Electronic minimization
ALGO = All
TIME = 0.05
LREAL = Auto

# Hubbard U

# Output settings
LWAVE = .TRUE.
LCHARG = .TRUE.
NWRITE = 1
