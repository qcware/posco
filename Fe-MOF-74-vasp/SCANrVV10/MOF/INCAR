SYSTEM = MOF

# Electronic Relaxation
ISTART = 0
ICHARG = 2
ISMEAR = 0  # Gaussian smearing
SIGMA = 0.1
ENCUT = 1000.0  # Typically, VASP recommends using higher ENCUT, set to 2 * Ecutwfc in QE
PREC = Accurate

# Spin polarization
ISPIN = 2
MAGMOM = 48*0.0 3*1.0 3*-1.0

# SCAN+rVV10 
METAGGA   = SCAN
LUSE_VDW  = .TRUE.
BPARAM    = 15.7    # the default value is 6.3
CPARAM    = 0.0093  # default but can be overwritten by this tag

# Convergence criteria
EDIFF = 1E-7
NELM = 500

# Ion relaxation
IBRION = -1  # No ionic relaxation
NSW = 0

# Electronic minimization
ALGO = All
TIME = 0.05
LREAL = Auto

# Hubbard U
LDAU = .TRUE.
LDAUTYPE = 2
LASPH = .TRUE.
LDAUL = -1 -1 -1 2 
LDAUU = 0.0 0.0 0.0 4.0 
LDAUJ = 0.0 0.0 0.0 0.0 
LDAUPRINT = 1

# Output settings
LWAVE = .TRUE.
LCHARG = .TRUE.
NWRITE = 1
LORBIT = 11
